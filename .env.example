# ─────────────────────────────────────────────────────────────
#  Пример конфигурации «Service Company»
#  Скопируйте в .env и замените значения-заглушки своими.
#  НЕ коммитьте реальный .env (в нём секреты).
# ─────────────────────────────────────────────────────────────

# ── База данных (Postgres) ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=autoservice
DB_USER=autoservice
DB_PASSWORD=changeme

# ── Redis (кэш/брокер Celery) ──
REDIS_URL=redis://redis:6379/0

# ── MinIO (S3-хранилище в compose; текущим кодом не используется) ──
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=autoservice

# ── VK ──
VK_GROUP_TOKEN=токен-группы-vk
VK_GROUP_ID=123456789
#VK Admin: id администратора (положительный) или id беседы (отрицательный)
ADMIN_VK_ID=123456789

# ── Секреты приложения (сгенерируйте свои случайные строки) ──
# HMAC_SECRET — подпись клиентских запросов и пароль веб-админки http://localhost:8000/admin
ENCRYPTION_KEY=random-hex-64
HMAC_SECRET=random-hex-64

# ── Внутренний URL бэкенда для ботов/Celery ──
BACKEND_INTERNAL_URL=http://backend:8000

# ── Сеть/сборка (опционально) ──
# Если pip не может выйти в интернет напрямую, задайте прокси и/или зеркало PyPI.
# В Docker Desktop встроенный прокси доступен как http.docker.internal:3128.
# HTTP_PROXY=http://proxy:3128
# HTTPS_PROXY=http://proxy:3128
# PIP_INDEX_URL=https://pypi.org/simple/
